NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. From Supabase dashboard: Project Settings > API > service_role key.
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Random string, e.g. `openssl rand -hex 32`. Used to salt the hashed source IP
# stored on responses for abuse control only (SPEC section 11).
IP_HASH_SALT=
